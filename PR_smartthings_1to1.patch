:root{
  --bg1:#0a3651; --bg2:#0b74a8; --bg3:#0fb7ed; --text:#f8fbff; --muted:#d7e7f3;
  --line:rgba(255,255,255,.18); --shadow:rgba(0,0,0,.25);
  --tile:#134f73; --banner:#d7263d; --ok:#20df9e; --off:#9aa7b3;
}
*{box-sizing:border-box} html,body{height:100%}
body{margin:0; color:var(--text); background:linear-gradient(180deg,var(--bg1),var(--bg2) 40%,var(--bg3))}
img{display:inline-block}
.ico{width:18px;height:18px;vertical-align:-3px}

.appbar{height:60px; display:flex; align-items:center; justify-content:space-between; padding:0 14px; background:linear-gradient(180deg,#0b74a8,#0a5f89); border-bottom:1px solid var(--line)}
.appbar .title{margin-left:8px; font-weight:800; letter-spacing:.02em}
.kpi{background:rgba(0,0,0,.25); padding:6px 10px; border-radius:999px; font-weight:700}

.banner{height:34px; display:flex; align-items:center; justify-content:center; background:var(--banner); color:white; font-weight:900; letter-spacing:.1em}

.content{padding:14px; padding-bottom:80px}
.deck{display:grid; grid-template-columns:repeat(2,minmax(280px,1fr)); gap:16px}
.card{position:relative; background:linear-gradient(180deg,#0b6fa5,#0a5f89); border-radius:18px; padding:14px; box-shadow:0 6px 14px var(--shadow), inset 0 0 0 1px var(--line)}
.card.wide{grid-column:1 / span 2}
.card-head{display:flex; align-items:center; gap:10px}
.chip-ico{width:22px;height:22px; opacity:.95}
.card-title{font-weight:800; opacity:.9}
.card-value{font-size:26px; font-weight:800; margin-top:6px}
.card-value.big{font-size:36px}
.unit{opacity:.7; font-size:12px; font-weight:700; margin-left:6px}

.chips{display:flex; gap:10px; margin-top:10px}
.chip{display:flex; align-items:center; gap:8px; padding:6px 10px; border-radius:999px; background:rgba(0,0,0,.2); font-weight:700}
.chip .dot{width:10px; height:10px; border-radius:50%; background:var(--off)}
.chip.on .dot{background:var(--ok)}

.tiles{display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin:14px 0}
.tile{background:var(--tile); color:var(--text); border:none; border-radius:14px; padding:12px; font-weight:800; display:flex; align-items:center; gap:8px; box-shadow:inset 0 0 0 1px var(--line)}
.tile:active{transform:translateY(1px)}

.update{margin-top:12px; color:var(--muted)}

.bottom{position:fixed; bottom:0; left:0; right:0; height:56px; display:flex; align-items:center; justify-content:space-around; background:linear-gradient(180deg,#0b74a8,#0a5f89); border-top:1px solid var(--line)}
.bottom a{color:var(--text); text-decoration:none; opacity:.9; display:flex; align-items:center; gap:6px; font-weight:700}
.bottom .ico{width:16px;height:16px}
.bottom a.active{opacity:1}

@media (max-width:720px){ .deck{grid-template-columns:1fr} .card.wide{grid-column:1} }

